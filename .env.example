# Optional local development override. .env.development already points at Django.
# Copy to .env.development.local if your local backend uses another address.
#
# Production leaves this empty and calls /api/v1 on the site's own origin.
# The Docker build excludes .env files and explicitly builds with an empty URL.
# Changing a running container's environment cannot reconfigure a Vite bundle.
# Everything prefixed VITE_ is public: never place credentials here.

# Local Django API origin, without /api/v1.
VITE_API_BASE_URL=http://localhost:8000
